# Copiar para .env (ou exportar) — nunca commitar valores reais.
JWT_SECRET=<obrigatório em publicação: openssl rand -hex 32>
# (a secret de dev 'dev-only-change-me' só serve para dev; com
#  NODE_ENV=production, o POST /v1/session devolve 503 em vez de emitir tokens)
# NODE_ENV=production
PORT=3001
# Sem DATABASE_URL a BD é SQLite (DB_PATH; por omissão backend/data/ceme.db).
# DATABASE_URL=postgres://user:pass@host:5432/db
# DB_PATH=./data/ceme.db
# Chave de API para terceiros (X-API-Key). Só o sha256 vai para a BD; tirar a
# variável e reiniciar revoga a chave (docs/04).
# CEME_API_KEY=<openssl rand -hex 32>
# Pedidos por minuto dessa chave (por omissão 60).
# CEME_API_KEY_RATE_LIMIT=600
# Previews/snapshots (docs/preview-envs.md):
# CEME_READONLY=1    # não escreve nada na BD (nem o OMIE)
# CEME_SKIP_SEED=1   # salta o seed
# As fontes e os TTLs do OMIE não são env vars — estão em src/omie/tf.js,
# src/omie/omiees.js e src/omie/pipeline.js (docs/03).
