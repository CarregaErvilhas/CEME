JWT_SECRET=<obrigatório em publicação: openssl rand -hex 32>
# (a secret de dev 'dev-only-change-me' só serve para dev; com
#  NODE_ENV=production, o POST /v1/session devolve 503 em vez de emitir tokens)
PORT=3001
DB_PATH=./data/ceme.db
# As fontes OMIE e o TTL do cache não são env vars — estão fixas em
# src/omie/cache.js (DAILY_URL, FUT_URL, QUARTERS_URL, TTL_MS).
# A ingestão directa do omie.es (docs/03) ainda não existe; quando existir,
# as variáveis entram aqui com o código que as usa.
